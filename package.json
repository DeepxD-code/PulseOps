{
  "name": "pulseops",
  "version": "1.0.0",
  "description": "PulseOps — automated backend engineering job search pipeline",
  "main": "linkedin_bridge.js",
  "scripts": {
    "bridge": "node linkedin_bridge.js",
    "install-playwright": "npx playwright install chromium",
