# ── PulseOps Configuration ─────────────────────────────────────────────────
# Copy to .env and fill in your values.
# Lines starting with # are comments.

# ── LLM Keys (PulseMatch AI cascade: Gemini → Groq → OpenAI) ──────────────
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey  (free tier)
GROQ_API_KEY=                     # https://console.groq.com            (free tier)
XAI_API_KEY=                      # Alternative Grok key (optional)
OPENAI_API_KEY=                   # https://platform.openai.com         (optional fallback)
PREFERRED_LLM=gemini              # gemini | groq | openai

# ── Job Sourcing ────────────────────────────────────────────────────────────
SEARCHAPI_API_KEY=                # https://www.searchapi.io  (Google Jobs engine)
THEIRSTACK_API_KEY=               # https://theirstack.com    (optional, large DB)
THEIRSTACK_COUNTRY_CODE=IN        # ISO country code for TheirStack filter
JOB_SEARCH_QUERY="software intern"
JOB_LOCATION=India
POSTED_AT_MAX_AGE_DAYS=7

# ── Resume & Output ─────────────────────────────────────────────────────────
BASE_RESUME_PATH=resume.md        # Your resume in Markdown or tagged-text format
OUTPUT_FOLDER=output              # Where PDFs and reports are saved

# ── Scoring Thresholds (Career-Ops philosophy) ──────────────────────────────
MATCH_THRESHOLD=75                # Minimum score to generate PDF resume
APPLY_THRESHOLD=80                # Minimum score to auto-send cold email
NOTIFY_THRESHOLD=70               # Minimum score to send Telegram alert

# ── Telegram Notifications (PulseMatch AI) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=               # From @BotFather on Telegram
TELEGRAM_CHAT_ID=                 # Run: python get_chat_id.py

# ── Discord Notifications (alternative to or alongside Telegram) ────────────
# Create a webhook: Channel Settings > Integrations > Webhooks > New Webhook
# Copy the URL and paste it here. Discord notifications are sent as rich embeds.
DISCORD_WEBHOOK_URL=              # Main alerts/matches: https://discord.com/api/webhooks/{id}/{token}
DISCORD_REVIEW_WEBHOOK_URL=       # Separate G10 human-review channel (JDs with no verified email)

# ── SMTP Email Auto-Dispatch ────────────────────────────────────────────────
AUTO_SEND_EMAILS=false            # Set true to enable auto cold-email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password   # Use a Gmail App Password, not your main password

# ── GitHub Resume Sync ──────────────────────────────────────────────────────
GITHUB_USERNAME=                  # Your GitHub username for project bullet sync

# ── Hunter.io — Verified recruiter email lookup ─────────────────────────────
# Fully optional. Requires signing up with an email on an actual company
# domain — personal Gmail/Outlook addresses are rejected at signup, so this
# isn't available to everyone. If you can't get a key, leave this blank:
# the pipeline runs in "dm_first" mode by default (see config/settings.yml
# -> outreach.mode) and every match still gets a full LinkedIn DM draft
# delivered to Telegram regardless. Nothing breaks without this key.
# Free tier (if you do have access): 25 email-finder lookups/month.
HUNTER_API_KEY=
MY_LINKEDIN=https://www.linkedin.com/in/your-profile
MY_GITHUB=https://github.com/your-username
MY_PORTFOLIO=https://your-portfolio.com

# ── IMAP Reply Detection (Gmail) ────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_EMAIL=your_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
